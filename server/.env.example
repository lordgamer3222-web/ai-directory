PORT=5001
MONGODB_URI=MONODBURI
GEMINI_API_KEY=your_gcp_api_key_here
GEMINI_MODEL=gemini-3.8-flash
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
# Optional: point this at a persistent disk or mounted volume in production.
# UPLOAD_DIR=/var/lib/ai-library/tool-icons
# Transactional password-reset email only (Resend API key and verified sender)
RESEND_API_KEY=your_resend_api_key
PASSWORD_RESET_FROM="AI Directory <noreply@your-verified-domain.com>"
